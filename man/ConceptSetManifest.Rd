\describe{
\item{\code{conceptSetId}}{Integer. The concept set ID in the manifest.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
Tibble with columns:
\itemize{
\item \code{conceptId}: Integer, the OMOP concept identifier
\item \code{conceptName}: Character, the concept name from the vocabulary
}
}
}
